  - label: Speech 4 - Wide Ah
    hotkey: 118
    jawDropUv: 0.086
    jawSideFollow: 0
    jawChinFocusPower: 2.6
    defaultWeight: 1
    muscleZones:
    - label: Ah Left Corner Round
      centerUv: {x: 0.405, y: 0.34}
      radiusUv: {x: 0.14, y: 0.11}
      displacementUv: {x: 0.004, y: 0}
      strength: 1
    - label: Ah Right Corner Round
      centerUv: {x: 0.595, y: 0.34}
      radiusUv: {x: 0.14, y: 0.11}
      displacementUv: {x: -0.004, y: 0}
      strength: 1
    - label: Ah Upper Lip Raise
      centerUv: {x: 0.5, y: 0.375}
      radiusUv: {x: 0.18, y: 0.065}
      displacementUv: {x: 0, y: 0.012}
      strength: 1.1
    - label: Ah Lower Lip Drop
      centerUv: {x: 0.5, y: 0.31}
      radiusUv: {x: 0.205, y: 0.07}
      displacementUv: {x: 0, y: -0.012}
      strength: 0.9
    bakedOffsets:
