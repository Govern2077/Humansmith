  - label: Speech 3 - Narrow Teeth / E
    hotkey: 99
    jawDropUv: 0.014
    jawSideFollow: 0
    jawChinFocusPower: 2.6
    defaultWeight: 1
    muscleZones:
    - label: E Left Corner Stretch
      centerUv: {x: 0.4, y: 0.34}
      radiusUv: {x: 0.15, y: 0.085}
      displacementUv: {x: -0.016, y: 0}
      strength: 1.1
    - label: E Right Corner Stretch
      centerUv: {x: 0.639104, y: 0.34}
      radiusUv: {x: 0.15, y: 0.085}
      displacementUv: {x: 0.016, y: 0}
      strength: 1.1
    - label: E Upper Lip Teeth Reveal
      centerUv: {x: 0.5, y: 0.37}
      radiusUv: {x: 0.185, y: 0.055}
      displacementUv: {x: 0, y: 0.0045}
      strength: 1
    - label: E Lower Lip Teeth Cover
      centerUv: {x: 0.5, y: 0.315}
      radiusUv: {x: 0.205, y: 0.055}
      displacementUv: {x: 0, y: 0.0035}
      strength: 0.85
