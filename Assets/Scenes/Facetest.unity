  - label: Speech 5 - Round O
    hotkey: 98
    jawDropUv: 0.038
    jawSideFollow: 0
    jawChinFocusPower: 2.6
    defaultWeight: 1
    muscleZones:
    - label: O Left Corner In
      centerUv: {x: 0.405, y: 0.34}
      radiusUv: {x: 0.135, y: 0.105}
      displacementUv: {x: 0.028, y: 0}
      strength: 1.15
    - label: O Right Corner In
      centerUv: {x: 0.634104, y: 0.34}
      radiusUv: {x: 0.135, y: 0.105}
      displacementUv: {x: -0.028, y: 0}
      strength: 1.15
    - label: O Upper Lip Teeth Cover
      centerUv: {x: 0.52132803, y: 0.37513962}
      radiusUv: {x: 0.165, y: 0.065}
      displacementUv: {x: 0, y: -0.0065}
      strength: 1
    - label: O Lower Lip Teeth Cover
      centerUv: {x: 0.51965123, y: 0.31166205}
      radiusUv: {x: 0.185, y: 0.065}
      displacementUv: {x: 0, y: 0.006}
      strength: 0.9
