  - label: Speech 2 - Open Teeth / A-E
    hotkey: 120
    jawDropUv: 0.03100112
    jawSideFollow: 0
    jawChinFocusPower: 2.6
    defaultWeight: 1
    muscleZones:
    - label: A-E Left Corner Wide
      centerUv: {x: 0.42841077, y: 0.33907586}
      radiusUv: {x: 0.145, y: 0.095}
      displacementUv: {x: -0.011687535, y: 0.017122967}
      strength: 1.05
    - label: A-E Right Corner Wide
      centerUv: {x: 0.6106932, y: 0.33907586}
      radiusUv: {x: 0.145, y: 0.095}
      displacementUv: {x: 0.011687535, y: 0.017122967}
      strength: 1.05
    - label: A-E Upper Lip Teeth Reveal
      centerUv: {x: 0.5190856, y: 0.3689379}
      radiusUv: {x: 0.185, y: 0.06}
      displacementUv: {x: 0.00021434967, y: 0.0025106044}
      strength: 1.05
